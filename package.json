{
  "name": "d-gitalcode.ma",
  "version": "1.0.0",
  "description": "D-GITALCODE — Premium digital agency platform with CMS, multilingual support, and admin dashboard",
  "author": "Abdelhamid <3ab2uelkarch2006@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/3ab2/d-gitalcode.ma.git"
  },
  "homepage": "https://d-gitalcode.ma",
  "keywords": [
    "nextjs",
    "typescript",
    "digital-agency",
    "prisma",
    "postgresql",
    "cms",
    "i18n",
    "tailwindcss"
  ],
  "private": true,
  "scripts": {
    "predev": "node scripts/clean-dev-cache.mjs",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "dev:prod": "npm run build && next start --hostname 0.0.0.0",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\"",
    "test:smoke": "node tests/smoke.mjs",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-blog": "tsx prisma/seed-blog.ts",
    "email:test": "tsx scripts/test-resend.ts",
    "email:test-errors": "tsx scripts/test-resend-errors.ts",
    "cloudinary:test": "tsx scripts/test-cloudinary.ts",
    "db:studio": "prisma studio",
    "assets:optimize": "node scripts/optimize-brand-assets.mjs",
    "assets:optimize-public": "node scripts/optimize-public-images.mjs",
    "pwa:icons": "node scripts/generate-brand-icons.mjs",
    "icons:generate": "node scripts/generate-brand-icons.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@serwist/turbopack": "^9.5.11",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-resources-to-backend": "^1.2.1",
    "lottie-react": "^2.4.1",
    "lucide-react": "^1.17.0",
    "next": "16.4.6",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.78.0",
    "react-i18next": "^17.0.8",
    "resend": "^6.12.4",
    "sanitize-html": "^2.17.5",
    "serwist": "^9.5.11",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.1",
    "@types/three": "^0.184.1",
    "esbuild": "^0.28.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "to-ico": "^1.1.5",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
