generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String          @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole        @default(CLIENT)
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  accounts      Account[]
  auditLogs     AdminAuditLog[]
  sessions      Session[]
  messages           ClientMessage[]
  messageReplies     MessageReply[]
  supportAttachments SupportAttachment[]
  notifications      Notification[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Service {
  id           String               @id @default(cuid())
  slug         String               @unique
  type         ServiceType
  price        Float?
  priceLabel   String?
  featured     Boolean              @default(false)
  published    Boolean              @default(true)
  image        String?
  demoUrl      String?
  order        Int                  @default(0)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  submissions  ContactSubmission[]
  translations ServiceTranslation[]
}

model ServiceTranslation {
  id          String   @id @default(cuid())
  serviceId   String
  locale      String
  title       String
  description String
  shortDesc   String?
  features    String[] @default([])
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, locale])
}

model PortfolioProject {
  id           String                 @id @default(cuid())
  slug         String                 @unique
  image        String?
  url          String?
  technologies String[]               @default([])
  featured     Boolean                @default(false)
  published    Boolean                @default(true)
  order        Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  githubUrl    String?
  translations PortfolioTranslation[]
}

model PortfolioTranslation {
  id          String           @id @default(cuid())
  projectId   String
  locale      String
  title       String
  description String
  client      String?
  project     PortfolioProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locale])
}

model BlogPost {
  id           String             @id @default(cuid())
  slug         String             @unique
  image        String?
  published    Boolean            @default(false)
  featured     Boolean            @default(false)
  views        Int                @default(0)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  publishedAt  DateTime?
  categories   BlogPostCategory[]
  tags         BlogPostTag[]
  translations BlogTranslation[]
}

model BlogTranslation {
  id              String   @id @default(cuid())
  postId          String
  locale          String
  title           String
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  post            BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
}

model BlogCategory {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  translations BlogCategoryTranslation[]
  posts        BlogPostCategory[]
}

model BlogCategoryTranslation {
  id         String       @id @default(cuid())
  categoryId String
  locale     String
  name       String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model BlogTag {
  id    String        @id @default(cuid())
  slug  String        @unique
  name  String
  posts BlogPostTag[]
}

model BlogPostCategory {
  postId     String
  categoryId String
  category   BlogCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  post       BlogPost     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model ContactSubmission {
  id          String            @id @default(cuid())
  name        String
  email       String
  phone       String?
  message     String
  type        ContactType       @default(GENERAL)
  method      ContactMethod     @default(FORM)
  serviceId   String?
  serviceName String?
  locale      String            @default("fr")
  createdAt   DateTime          @default(now())
  status      SubmissionStatus  @default(NEW)
  updatedAt   DateTime          @default(now()) @updatedAt
  service     Service?          @relation(fields: [serviceId], references: [id])
  replies     SubmissionReply[]
}

model SubmissionReply {
  id           String            @id @default(cuid())
  submissionId String
  subject      String
  message      String
  sentTo       String
  status       ReplyStatus       @default(PENDING)
  sentBy       String?
  error        String?
  createdAt    DateTime          @default(now())
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String
  userEmail String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SiteStat {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String
}

model AnalyticsEvent {
  id        String   @id @default(cuid())
  event     String
  page      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([event, createdAt])
}

model ClientMessage {
  id        String         @id @default(cuid())
  userId    String
  subject   String         @default("Support request")
  content   String
  status    MessageStatus  @default(OPEN)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     MessageReply[]
  attachments SupportAttachment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model MessageReply {
  id        String        @id @default(cuid())
  messageId String
  adminId   String
  content   String
  createdAt DateTime      @default(now())
  message     ClientMessage        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  admin       User                 @relation(fields: [adminId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([messageId])
  @@index([messageId, createdAt])
}

model SupportAttachment {
  id           String         @id @default(cuid())
  messageId    String?
  replyId      String?
  originalName String
  mimeType     String
  fileSize     Int
  storageKey   String         @unique
  secureUrl    String?
  publicId     String?
  uploadedById String
  createdAt    DateTime       @default(now())
  message      ClientMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reply        MessageReply?  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([replyId])
  @@index([uploadedById])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@index([type])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  label     String
  enabled   Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

enum UserRole {
  ADMIN
  CLIENT
  USER
}

enum MessageStatus {
  OPEN
  REPLIED
}

enum NotificationType {
  SUPPORT_REPLY
  NEW_MESSAGE
  SYSTEM
  ACCOUNT
  PROJECT_UPDATE
}

enum ServiceType {
  WEB_DEVELOPMENT
  MOBILE_APPS
  WORDPRESS_PLUGINS
  WORDPRESS_TEMPLATES
}

enum ContactType {
  GENERAL
  SERVICE_REQUEST
}

enum ContactMethod {
  FORM
  WHATSAPP
}

enum SubmissionStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum ReplyStatus {
  SENT
  FAILED
  PENDING
}
